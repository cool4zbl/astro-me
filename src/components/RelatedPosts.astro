---
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { getLocalizedPath } from '../i18n/config';

const { currentSlug, currentTags, lang = 'zh' } = Astro.props;
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter((post) => post.id !== currentSlug && !post.data.draft)
  .map((post) => ({
    ...post,
    similarity: post.data.tags.filter((tag) => currentTags.includes(tag)).length,
  }))
  .filter((post) => post.similarity > 0)
  .sort((a, b) => b.similarity - a.similarity)
  .slice(0, 3);

const texts = {
  zh: { title: '相关文章' },
  en: { title: 'Related writing' },
};
const t = texts[lang] ?? texts.en;
---

{relatedPosts.length > 0 && (
  <section class="related-editorial">
    <p class="related-eyebrow">Keep reading</p>
    <h2>{t.title}</h2>
    <ol>
      {relatedPosts.map((post) => (
        <li>
          <article>
            <FormattedDate date={post.data.publishedAt} />
            <div>
              <h3><a href={getLocalizedPath(`/blog/${post.id}/`, lang)}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
            </div>
            <span aria-hidden="true">↗</span>
          </article>
        </li>
      ))}
    </ol>
  </section>
)}

<style>
  .related-editorial { margin-top: 4rem; border-top: 1px solid hsl(var(--border)); padding-top: 3rem; }
  .related-eyebrow { color: hsl(var(--primary)); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; }
  .related-editorial > h2 { margin-top: 0.6rem; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 400; }
  .related-editorial ol { border-top: 1px solid hsl(var(--border)); margin-top: 1.5rem; }
  .related-editorial li { border-bottom: 1px solid hsl(var(--border)); }
  .related-editorial article { display: grid; grid-template-columns: 8rem minmax(0, 1fr) auto; gap: 1.25rem; padding: 1.5rem 0; }
  .related-editorial time { color: hsl(var(--muted-foreground)); font-size: 0.7rem; text-transform: uppercase; }
  .related-editorial h3 { font-family: Georgia, 'Times New Roman', serif; font-size: 1.25rem; font-weight: 400; line-height: 1.2; }
  .related-editorial h3 a {
    color: hsl(var(--foreground));
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, hsl(var(--primary)) 45%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  .related-editorial article:hover h3 a { color: hsl(var(--primary)); text-decoration-color: hsl(var(--primary)); }
  .related-editorial article p { margin-top: 0.45rem; color: hsl(var(--muted-foreground)); font-size: 0.84rem; }
  .related-editorial article > span { color: hsl(var(--primary)); }
  @media (max-width: 560px) {
    .related-editorial article { grid-template-columns: 1fr auto; }
    .related-editorial time { grid-column: 1 / -1; }
  }
</style>
