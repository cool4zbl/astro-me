---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import { getLangFromUrl, getLocalizedPath, type Language } from '../i18n/config';
import { getHomeCopy } from '../i18n/pages/home';
import { getPageMetadata } from '../utils/metadata';

const lang: Language = Astro.props?.lang ?? getLangFromUrl(Astro.url);
const copy = getHomeCopy(lang);
const { title: pageTitle, description: pageDescription } = getPageMetadata('home');

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 5);

const primaryHref = getLocalizedPath(copy.hero.primary.href, lang);
const secondaryHref = getLocalizedPath(copy.hero.secondary.href, lang);
const projectsHref = getLocalizedPath('/projects', lang);
const blogHref = getLocalizedPath('/blog', lang);
const personalHref = getLocalizedPath(copy.personal.link.href, lang);

const profileImage = '/binliuzhang-avt1.JPG';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Header />

  <main class="editorial-home flex-1">
    <section class="hero-section">
      <div class="editorial-container hero-layout">
        <div class="hero-copy">
          <p class="eyebrow">{copy.hero.label}</p>
          <h1>{copy.hero.title}</h1>
          <div class="hero-description">
            {copy.hero.description.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <div class="hero-actions">
            <a class="text-link text-link-primary" href={primaryHref}>
              {copy.hero.primary.label}<span aria-hidden="true">↓</span>
            </a>
            <a class="text-link" href={secondaryHref}>
              {copy.hero.secondary.label}<span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <figure class="portrait">
          <OptimizedImage
            src={profileImage}
            alt="Binliu Zhang"
            width={520}
            height={650}
            class="portrait-image"
            loading="eager"
          />
        </figure>
      </div>
    </section>

    <section class="writing-section" id="writing" aria-labelledby="writing-title">
      <div class="editorial-container section-grid">
        <header class="section-intro">
          <p class="eyebrow">{copy.writing.eyebrow}</p>
          <h2 id="writing-title">{copy.writing.title}</h2>
          <p>{copy.writing.description}</p>
        </header>

        <div>
          {recentPosts.length > 0 ? (
            <ol class="post-list">
              {recentPosts.map((post) => {
                const postHref = getLocalizedPath(`/blog/${post.id}/`, lang);
                const firstTag = post.data.tags[0];

                return (
                  <li>
                    <article class={`post-row${post.data.heroImage ? ' has-thumbnail' : ''}`}>
                      <div class="post-meta">
                        <FormattedDate date={post.data.publishedAt} />
                        {firstTag && (
                          <a href={getLocalizedPath(`/tags/${firstTag}/`, lang)}>{firstTag}</a>
                        )}
                      </div>
                      <div class="post-copy">
                        <h3><a href={postHref}>{post.data.title}</a></h3>
                        <p>{post.data.description}</p>
                      </div>
                      {post.data.heroImage && (
                        <a class="post-thumbnail" href={postHref} aria-label={`Read ${post.data.title}`}>
                          <OptimizedImage
                            src={post.data.heroImage}
                            alt=""
                            width={320}
                            height={240}
                            sizes="(max-width: 760px) 104px, 120px"
                            format="webp"
                            class="post-thumbnail-image"
                            loading="lazy"
                          />
                        </a>
                      )}
                      <span class="post-arrow" aria-hidden="true">↗</span>
                    </article>
                  </li>
                );
              })}
            </ol>
          ) : (
            <p class="empty-state">{copy.writing.emptyLabel}</p>
          )}

          <a class="text-link section-link" href={blogHref}>
            {copy.writing.viewAllLabel}<span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="work-section" aria-labelledby="work-title">
      <div class="editorial-container section-grid">
        <header class="section-intro">
          <p class="eyebrow">{copy.work.eyebrow}</p>
          <h2 id="work-title">{copy.work.title}</h2>
          <p>{copy.work.description}</p>
        </header>

        <div>
          <ol class="work-list">
            {copy.work.items.map((project, index) => (
              <li>
                <span class="work-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                </div>
              </li>
            ))}
          </ol>
          <a class="text-link section-link" href={projectsHref}>
            {copy.work.viewAllLabel}<span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="personal-section" aria-labelledby="personal-title">
      <div class="editorial-container section-grid">
        <header class="section-intro">
          <p class="eyebrow">{copy.personal.eyebrow}</p>
          <h2 id="personal-title">{copy.personal.title}</h2>
        </header>

        <div class="personal-copy">
          <p>{copy.personal.description}</p>
          <a class="text-link section-link" href={personalHref}>
            {copy.personal.link.label}<span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .editorial-home {
    --home-canvas: hsl(var(--background));
    --home-surface: hsl(var(--card));
    --home-ink: hsl(var(--foreground));
    --home-muted: hsl(var(--muted-foreground));
    --home-rule: hsl(var(--border));
    --home-accent: hsl(var(--primary-darkest));
    background: var(--home-canvas);
    color: var(--home-ink);
  }

  :global(.dark) .editorial-home {
    --home-accent: hsl(var(--primary));
  }

  .editorial-container {
    width: min(100% - 2rem, 74rem);
    margin-inline: auto;
  }

  .hero-section {
    padding: clamp(5rem, 11vw, 9rem) 0 clamp(4.5rem, 9vw, 7.5rem);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 50rem) auto;
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
  }

  .hero-copy h1,
  .section-intro h2 {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 400;
    text-wrap: balance;
  }

  .hero-copy h1 {
    max-width: 18ch;
    margin-top: 1.25rem;
    font-size: clamp(2.75rem, 6vw, 5.6rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .eyebrow {
    color: var(--home-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .hero-description {
    max-width: 40rem;
    margin-top: 2.5rem;
    color: var(--home-muted);
    font-size: clamp(1rem, 1.5vw, 1.125rem);
  }

  .hero-description p + p {
    margin-top: 0.8rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 2.25rem;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    border-bottom: 1px solid var(--home-accent);
    color: var(--home-accent);
    font-size: 0.875rem;
    font-weight: 650;
    padding-bottom: 0.2rem;
    transition: border-color 160ms ease, color 160ms ease;
  }

  .text-link:hover,
  .text-link-primary {
    border-color: var(--home-accent);
    color: var(--home-accent);
  }

  .text-link:hover {
    border-bottom-width: 2px;
  }

  .portrait {
    width: clamp(9rem, 16vw, 13.5rem);
    aspect-ratio: 1;
    overflow: hidden;
    justify-self: end;
    border-radius: 9999px;
    box-shadow: 0 1.25rem 3rem color-mix(in srgb, var(--home-ink) 16%, transparent);
  }

  :global(.portrait-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 42%;
    filter: saturate(0.85);
  }

  .writing-section,
  .personal-section,
  .work-section {
    border-top: 1px solid var(--home-rule);
    padding: clamp(4rem, 8vw, 7rem) 0;
  }

  .writing-section {
    scroll-margin-top: 5rem;
  }

  .work-section {
    background: var(--home-surface);
  }

  .personal-section {
    background: color-mix(in srgb, var(--home-canvas) 60%, var(--home-surface));
  }

  .section-grid {
    display: grid;
    grid-template-columns: minmax(13rem, 0.7fr) minmax(0, 1.55fr);
    gap: clamp(3rem, 9vw, 9rem);
  }

  .section-intro h2 {
    max-width: 13ch;
    margin-top: 0.85rem;
    font-size: clamp(2.1rem, 4vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .section-intro > p:last-child {
    max-width: 30rem;
    margin-top: 1.25rem;
    color: var(--home-muted);
    font-size: 0.95rem;
  }

  .personal-copy > p {
    max-width: 46rem;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.15rem, 1.6vw, 1.55rem);
    line-height: 1.58;
  }

  .post-list,
  .work-list {
    border-top: 1px solid var(--home-rule);
  }

  .post-list > li,
  .work-list > li {
    border-bottom: 1px solid var(--home-rule);
  }

  .post-row {
    position: relative;
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr) auto;
    gap: 1.5rem;
    padding: 1.7rem 0;
  }

  .post-row.has-thumbnail {
    grid-template-columns: 8.5rem minmax(0, 1fr) 7.5rem auto;
  }

  .post-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    color: var(--home-muted);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .post-meta a {
    color: var(--home-accent);
  }

  .post-copy h3,
  .work-list h3 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    font-weight: 400;
    line-height: 1.2;
  }

  .post-copy h3 a {
    color: var(--home-ink);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--home-accent) 45%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    transition: color 160ms ease;
  }

  .post-row:hover .post-copy h3 a,
  .post-copy h3 a:hover {
    color: var(--home-accent);
    text-decoration-color: var(--home-accent);
  }

  .post-copy p,
  .work-list p {
    margin-top: 0.55rem;
    color: var(--home-muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .post-arrow {
    color: var(--home-accent);
    font-size: 1rem;
  }

  .post-thumbnail {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    align-self: start;
    border: 1px solid var(--home-rule);
    border-radius: 0.3rem;
    background: var(--home-surface);
  }

  :global(.post-thumbnail-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.82) contrast(0.96);
    transition: filter 180ms ease;
  }

  .post-row:hover :global(.post-thumbnail-image) {
    filter: saturate(1) contrast(1);
  }

  .work-list > li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1.25rem;
    padding: 1.7rem 0;
  }

  .work-number {
    color: var(--home-accent);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.7rem;
    padding-top: 0.35rem;
  }

  .section-link {
    margin-top: 2rem;
  }

  .empty-state {
    border-block: 1px solid var(--home-rule);
    color: var(--home-muted);
    padding: 2rem 0;
  }

  .editorial-home :is(a, button):focus-visible {
    border-radius: 0.2rem;
    box-shadow: 0 0 0 3px var(--home-canvas), 0 0 0 5px var(--home-accent) !important;
  }

  @media (max-width: 760px) {
    .hero-layout,
    .section-grid {
      grid-template-columns: 1fr;
    }

    .hero-copy h1 {
      max-width: 20ch;
    }

    .portrait {
      width: 9rem;
      margin-top: 0.5rem;
      justify-self: center;
    }

    .post-row {
      grid-template-columns: 1fr;
      gap: 0.9rem 1rem;
    }

    .post-meta {
      grid-column: 1 / -1;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem 0.9rem;
    }

    .post-arrow {
      display: none;
    }

    .post-row.has-thumbnail {
      grid-template-columns: 6.5rem minmax(0, 1fr);
    }

    .post-row.has-thumbnail .post-copy {
      grid-column: 2;
      grid-row: 2;
    }

    .post-row.has-thumbnail .post-thumbnail {
      grid-column: 1;
      grid-row: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .text-link,
    .post-copy h3 a,
    :global(.post-thumbnail-image) {
      transition: none;
    }
  }
</style>
