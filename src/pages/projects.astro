---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import { getLangFromUrl, type Language } from '../i18n/config';
import { getProjectsCopy } from '../i18n/pages/projects';
import { getPageMetadata } from '../utils/metadata';

const lang: Language = Astro.props?.lang ?? getLangFromUrl(Astro.url);
const copy = getProjectsCopy(lang);
const { title: pageTitle, description: pageDescription } = getPageMetadata('projects');
const isExternal = (href?: string) => Boolean(href?.startsWith('http'));
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Header />

  <main class="projects-editorial flex-1">
    <section class="projects-hero">
      <div class="projects-container hero-grid">
        <div>
          <p class="projects-eyebrow">Selected work</p>
          <h1>Systems built around real problems.</h1>
        </div>
        <p>{copy.hero.description}</p>
      </div>
    </section>

    <section class="featured-section" aria-label="Featured projects">
      <div class="projects-container">
        <ol class="featured-list">
          {copy.featured.map((project, index) => (
            <li>
              <aside class="project-meta">
                <div>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <p>{project.badge.label}</p>
                  {project.subtitle && <small>{project.subtitle}</small>}
                </div>
                <figure class="project-thumbnail">
                  <OptimizedImage
                    src={project.image.src.split('?')[0]}
                    alt={project.image.alt}
                    width={640}
                    height={480}
                    sizes="(max-width: 760px) 100vw, 300px"
                    format="webp"
                    class="project-thumbnail-image"
                    loading="lazy"
                  />
                </figure>
              </aside>

              <article>
                <h2>{project.title}</h2>
                <p class="project-lede">{project.description}</p>

                <div class="project-details">
                  {project.sections.map((section) => (
                    <section>
                      <h3>{section.title}</h3>
                      <ul>
                        {section.items.map((item) => <li>{item}</li>)}
                      </ul>
                    </section>
                  ))}
                </div>

                <ul class="project-stack" aria-label={`${project.title} technologies`}>
                  {project.stack.map((tech) => <li>{tech}</li>)}
                </ul>

                {project.actions && project.actions.length > 0 && (
                  <div class="project-actions">
                    {project.actions.map((action) => (
                      <a
                        href={action.href ?? '#'}
                        target={isExternal(action.href) ? '_blank' : undefined}
                        rel={isExternal(action.href) ? 'noopener noreferrer' : undefined}
                      >
                        {action.label}<span aria-hidden="true">{isExternal(action.href) ? '↗' : '→'}</span>
                      </a>
                    ))}
                  </div>
                )}
              </article>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="other-section" aria-labelledby="other-title">
      <div class="projects-container other-grid">
        <header>
          <p class="projects-eyebrow">Also built</p>
          <h2 id="other-title">{copy.other.title}</h2>
          <p>{copy.other.description}</p>
        </header>

        <ol>
          {copy.other.cards.map((card, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <figure class="other-thumbnail">
                <OptimizedImage
                  src={card.image.src.split('?')[0]}
                  alt={card.image.alt}
                  width={320}
                  height={240}
                  sizes="(max-width: 760px) 96px, 112px"
                  format="webp"
                  class="project-thumbnail-image"
                  loading="lazy"
                />
              </figure>
              <div>
                <h3>{card.title}</h3>
                <p>{card.description}</p>
                <ul aria-label={`${card.title} technologies`}>{card.tags.map((tag) => <li>{tag}</li>)}</ul>
                {card.url && <a href={card.url} target="_blank" rel="noopener noreferrer">Visit project <b aria-hidden="true">↗</b></a>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .projects-editorial {
    --page-ink: hsl(var(--foreground));
    --page-muted: hsl(var(--muted-foreground));
    --page-rule: hsl(var(--border));
    --page-accent: hsl(var(--primary-darkest));
    background: hsl(var(--background));
    color: var(--page-ink);
  }

  :global(.dark) .projects-editorial { --page-accent: hsl(var(--primary)); }
  .projects-container { width: min(100% - 2rem, 74rem); margin-inline: auto; }

  .projects-hero { padding: clamp(5rem, 11vw, 9rem) 0 clamp(4.5rem, 9vw, 7rem); }
  .hero-grid, .other-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.85fr); gap: clamp(3rem, 9vw, 9rem); align-items: end; }

  .projects-eyebrow { color: var(--page-accent); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; }
  h1, h2, h3 { font-family: Georgia, 'Times New Roman', serif; font-weight: 400; }
  h1 { max-width: 13ch; margin-top: 1.1rem; font-size: clamp(3.4rem, 7vw, 6.4rem); line-height: 0.96; letter-spacing: -0.045em; }
  .hero-grid > p { color: var(--page-muted); font-size: clamp(1rem, 1.5vw, 1.12rem); }

  .featured-section { border-top: 1px solid var(--page-rule); background: hsl(var(--card)); }
  .featured-list > li { display: grid; grid-template-columns: minmax(15rem, 0.65fr) minmax(0, 1.35fr); gap: clamp(2.5rem, 7vw, 7rem); border-bottom: 1px solid var(--page-rule); padding: clamp(3.5rem, 7vw, 6rem) 0; }

  .project-meta { color: var(--page-accent); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .project-meta p { margin-top: 1rem; font-weight: 700; }
  .project-meta small { display: block; margin-top: 0.35rem; color: var(--page-muted); }

  .project-thumbnail,
  .other-thumbnail {
    overflow: hidden;
    border: 1px solid var(--page-rule);
    border-radius: 0.35rem;
    background: hsl(var(--muted));
  }

  .project-thumbnail {
    width: 100%;
    aspect-ratio: 4 / 3;
    margin-top: 2rem;
  }

  :global(.project-thumbnail-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.88) contrast(0.97);
  }

  .featured-list h2 { max-width: 18ch; font-size: clamp(2.25rem, 5vw, 4.25rem); line-height: 1; letter-spacing: -0.04em; }
  .project-lede { max-width: 52rem; margin-top: 1.25rem; color: var(--page-muted); font-size: clamp(1rem, 1.5vw, 1.1rem); }

  .project-details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem; margin-top: 2.5rem; }
  .project-details h3 { color: var(--page-accent); font-family: inherit; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .project-details ul { margin-top: 0.9rem; color: var(--page-muted); font-size: 0.88rem; }
  .project-details li { position: relative; padding-left: 1rem; }
  .project-details li + li { margin-top: 0.6rem; }
  .project-details li::before { position: absolute; left: 0; color: var(--page-accent); content: '—'; }

  .project-stack { display: flex; flex-wrap: wrap; gap: 0.55rem 1.25rem; margin-top: 2rem; color: var(--page-muted); font-size: 0.7rem; letter-spacing: 0.07em; text-transform: uppercase; }
  .project-stack li { display: flex; align-items: center; gap: 0.5rem; }
  .project-stack li::before { width: 0.25rem; height: 0.25rem; border-radius: 999px; background: var(--page-accent); content: ''; }

  .project-actions { display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin-top: 2rem; }
  .project-actions a, .other-section a { display: inline-flex; gap: 0.5rem; border-bottom: 1px solid var(--page-accent); color: var(--page-accent); font-size: 0.85rem; font-weight: 650; padding-bottom: 0.2rem; }
  .project-actions a:hover, .other-section a:hover { border-bottom-width: 2px; border-color: var(--page-accent); color: var(--page-accent); }

  .other-section { border-top: 1px solid var(--page-rule); padding: clamp(4rem, 8vw, 7rem) 0; }
  .other-grid { align-items: start; }
  .other-grid header h2 { margin-top: 0.9rem; font-size: clamp(2.25rem, 4vw, 3.6rem); line-height: 1.05; }
  .other-grid header > p:last-child { margin-top: 1.2rem; color: var(--page-muted); font-size: 0.92rem; }
  .other-grid > ol { border-top: 1px solid var(--page-rule); }
  .other-grid > ol > li { display: grid; grid-template-columns: 2.5rem 7rem minmax(0, 1fr); gap: 1rem; border-bottom: 1px solid var(--page-rule); padding: 1.7rem 0; }
  .other-grid > ol > li > span { color: var(--page-accent); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.7rem; }
  .other-thumbnail { width: 7rem; aspect-ratio: 4 / 3; }
  .other-grid h3 { font-size: 1.4rem; }
  .other-grid li p { margin-top: 0.5rem; color: var(--page-muted); font-size: 0.88rem; }
  .other-grid li ul { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin-top: 0.9rem; color: var(--page-muted); font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .other-grid li a { margin-top: 1rem; }

  .projects-editorial a:focus-visible { border-radius: 0.2rem; box-shadow: 0 0 0 3px hsl(var(--background)), 0 0 0 5px var(--page-accent) !important; }

  @media (max-width: 760px) {
    .hero-grid, .other-grid, .featured-list > li { grid-template-columns: 1fr; }
    .project-details { grid-template-columns: 1fr; }
    .project-meta { display: grid; grid-template-columns: 1fr minmax(10rem, 0.7fr); gap: 1.5rem; align-items: start; }
    .project-thumbnail { margin-top: 0; }
    .other-grid > ol > li { grid-template-columns: 2rem 6rem minmax(0, 1fr); }
    .other-thumbnail { width: 6rem; }
  }

  @media (max-width: 480px) {
    .project-meta { grid-template-columns: 1fr; }
    .project-thumbnail { width: min(100%, 22rem); }
    .other-grid > ol > li { grid-template-columns: 6rem minmax(0, 1fr); }
    .other-grid > ol > li > span { grid-column: 1 / -1; }
  }
</style>
