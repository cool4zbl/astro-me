---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPageMetadata } from '../utils/metadata';

const resume = {
  en: '/Binliu Zhang-Senior-Software-Engineer.pdf',
    // todo: add Chinese version later
  zh: '/Binliu Zhang-Senior-Software-Engineer.pdf',
};

const experiences = [
  {
    title: "Senior Software Engineer",
    company: "Just Eat Takeaway",
    department: "Help Experience / Platform",
    location: "Enschede, Netherlands",
    period: "May 2023 – Present",
    current: true,
    description: "Own end-to-end automation for customer support operations across Europe, partnering with product, operations, and data teams to design resilient platforms that keep millions of orders moving smoothly.",
    highlights: [
      "Designed an event-driven orchestration layer (Java, Spring Boot, Kafka, AWS SQS, Redis) for the help chatbot, cutting manual interventions by 60% and improving stability.",
      "Architected JETMS, a unified operational platform with multi-tenant routing and a shared data model that consolidates 20+ services and trims resolution SLAs by ~33%.",
      "Built a centralized logging pipeline with Benthos, Kafka, AWS SQS, and OpenSearch to process 50K+ logs/day and reduce MTTR by 25%.",
      "Drove instrumentation, documentation, and incident reviews that strengthened on-call readiness across the platform."
    ],
    skills: ["Java", "Spring Boot", "Kafka", "AWS", "Redis", "TypeScript"],
    icon: "building",
    theme: "primary"
  },
  {
    title: "Senior Software Engineer",
    company: "Grab",
    department: "Geo – Map Collection",
    location: "Beijing, China",
    period: "Feb 2021 – Apr 2023",
    current: false,
    description: "Led geospatial data platforms that power Grab's ride-hailing and delivery experiences, balancing contributor workflows, data quality, and downstream service requirements.",
    highlights: [
      "Built Jarvis, a crowdsourced task management platform (Go, PostgreSQL, ElasticSearch, Kafka) scaling to 300K tasks and 400K+ geospatial data points.",
      "Engineered KartaView, a high-performance street-view service backed by PostGIS and the Douglas–Peucker algorithm to shrink geospatial data size by 70% and accelerate queries.",
      "Delivered a distributed notification system with Redis locks, Kafka, and ElasticSearch providing exactly-once delivery for 10K+ monthly notifications.",
      "Partnered with product ops to prioritize roadmap, instrumentation, and rollout strategies across Southeast Asia markets."
    ],
    skills: ["Go", "PostgreSQL", "Kafka", "Redis", "ElasticSearch", "Distributed Systems", "PostGIS"],
    icon: "badge-check",
    theme: "accent"
  },
  {
    title: "Senior Software Engineer",
    company: "Ant Group",
    department: "AI Data Platform",
    location: "Beijing, China",
    period: "Jan 2018 – Jul 2020",
    current: false,
    description: "Re-architected experimentation infrastructure used by Ant Group's consumer and merchant products, enabling faster iteration while maintaining rigorous governance.",
    highlights: [
      "Rebuilt Darwin experimentation platform (client SDKs + Java APIs) with standardized contracts supporting 15M+ DAUs and 1,000+ experiments annually.",
      "Developed a full-stack traffic-splitting SDK with secondary hashing and client caching to cut server compute cost by 40% while ensuring consistent experiment allocation.",
      "Partnered with data scientists and PMs to craft governance that delivered a 2% conversion lift and $10M+ annual impact."
    ],
    skills: ["TypeScript", "Java", "Experimentation", "SDK Design"],
    icon: "code",
    theme: "secondary"
  },
  {
    title: "Software Engineer",
    company: "Douban",
    department: "User Product",
    location: "Beijing, China",
    period: "Jul 2015 – Sep 2017",
    current: false,
    description: "Delivered core social and media features for one of China's largest cultural communities, collaborating with designers and product managers on experiences used by 100M+ users.",
    highlights: [
      "Shipped and maintained high-traffic Python and JavaScript services across web and mobile surface."
    ],
    skills: ["Python", "JavaScript", "Web Development", "Product Engineering"],
    icon: "layers",
    theme: "muted"
  },
  {
    title: "B.Sc. Electronic Engineering",
    company: "University of Electronic Science and Technology of China",
    department: "",
    location: "",
    period: "2015 - 2019",
    current: false,
    description: "Focused on embedded systems, signal processing, and software engineering fundamentals while collaborating on multidisciplinary projects that sparked my interest in large-scale platforms.",
    highlights: [
      "Studied C programming, embedded systems, digital circuits, and analog circuits.",
      "Gained an understanding of the underlying computer hardware components and computer system architecture.",
      "I still find software development interesting, so I taught myself web development before graduation."
    ],
    skills: ["Electronic Engineering", "Signal Processing", "Algorithms", "Embedded Systems"],
    icon: "academic-cap",
    theme: "muted",
    isEducation: true
  }
];

const { title: pageTitle, description: pageDescription } = getPageMetadata('experience');

---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Header />

  <main class="experience-editorial flex-1">
    <section class="experience-hero">
      <div class="experience-container hero-grid">
        <div>
          <p class="experience-eyebrow">The work so far</p>
          <h1>Experience</h1>
        </div>
        <div class="hero-summary">
        <p>
          9+ years architecting distributed platforms for food delivery, mobility, fintech, and consumer communities—owning everything from event-driven services and data pipelines to the operational tooling teams rely on every day.
        </p>
        <div class="resume-action">
          <a
            href={resume[Astro.props.lang || 'en']}
            download="Binliu-Zhang-Senior-Software-Engineer.pdf"
          >
            Download résumé <span aria-hidden="true">↓</span>
          </a>
        </div>
        </div>
      </div>
    </section>

    <section class="experience-list-section" aria-label="Work and education history">
      <div class="experience-container">
        <div class="experience-list">

          <div>

            {experiences.map((exp, index) => (
              <article class="experience-entry">
                <div class="timeline-icon" aria-hidden="true">
                  <div>
                    {String(index + 1).padStart(2, '0')}
                  </div>
                </div>
                <div class="experience-card">
                    <div class="experience-heading">
                      <div>
                        <p class="company-line">
                          {exp.company}{exp.department && ` · ${exp.department}`}
                        </p>
                        <h2>{exp.title}</h2>
                        {exp.location && <p class="location-line">{exp.location}</p>}
                      </div>
                      <div class="period-line">
                        {exp.current && (
                          <span>Current</span>
                        )}
                        <p>{exp.period}</p>
                      </div>
                    </div>

                    <p class="experience-description">
                      {exp.description}
                    </p>

                    <div class="experience-highlights">
                        <h3>Selected notes</h3>
                        <ul>
                          {exp.highlights.map((highlight) => (
                            <li>{highlight}</li>
                          ))}
                        </ul>
                    </div>

                    <ul class="experience-skills" aria-label={`${exp.company} skills`}>
                      {exp.skills.map((skill) => (
                        <li>{skill}</li>
                      ))}
                    </ul>
                </div>
              </article>
            ))}

          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  .experience-editorial {
    --page-ink: hsl(var(--foreground));
    --page-muted: hsl(var(--muted-foreground));
    --page-rule: hsl(var(--border));
    --page-accent: hsl(var(--primary-darkest));
    background: hsl(var(--background));
    color: var(--page-ink);
  }

  :global(.dark) .experience-editorial { --page-accent: hsl(var(--primary)); }
  .experience-container { width: min(100% - 2rem, 74rem); margin-inline: auto; }
  .experience-hero { padding: clamp(5rem, 11vw, 9rem) 0 clamp(4.5rem, 9vw, 7rem); }

  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.8fr); gap: clamp(3rem, 9vw, 9rem); align-items: end; }
  .experience-eyebrow { color: var(--page-accent); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; }
  h1, h2 { font-family: Georgia, 'Times New Roman', serif; font-weight: 400; }
  h1 { margin-top: 1rem; font-size: clamp(4rem, 9vw, 7.5rem); line-height: 0.9; letter-spacing: -0.05em; }
  .hero-summary > p { color: var(--page-muted); font-size: clamp(1rem, 1.5vw, 1.1rem); }
  .resume-action { margin-top: 1.7rem; }
  .resume-action a { display: inline-flex; gap: 0.5rem; border-bottom: 1px solid var(--page-accent); color: var(--page-accent); font-size: 0.85rem; font-weight: 650; padding-bottom: 0.2rem; }

  .experience-list-section { border-top: 1px solid var(--page-rule); background: hsl(var(--card)); }
  .experience-list > div { border-top: 1px solid var(--page-rule); }
  .experience-list { padding: clamp(3.5rem, 7vw, 6rem) 0; }
  .experience-entry { display: grid; grid-template-columns: 5rem minmax(0, 1fr); gap: clamp(1.5rem, 5vw, 4rem); border-bottom: 1px solid var(--page-rule); padding: clamp(2.5rem, 5vw, 4rem) 0; }
  .timeline-icon > div { display: flex; align-items: center; justify-content: center; width: 3rem; height: 3rem; border: 1px solid var(--page-rule); border-radius: 999px; background: transparent; color: var(--page-accent); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.7rem; box-shadow: none; }
  .experience-heading { display: flex; justify-content: space-between; gap: 2rem; }
  .company-line { color: var(--page-accent); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .experience-heading h2 { margin-top: 0.65rem; font-size: clamp(1.9rem, 4vw, 3.25rem); line-height: 1.05; letter-spacing: -0.03em; }
  .location-line, .period-line { color: var(--page-muted); font-size: 0.76rem; }
  .location-line { margin-top: 0.5rem; }
  .period-line { flex: 0 0 auto; text-align: right; }
  .period-line span { display: block; margin-bottom: 0.35rem; color: var(--page-accent); font-weight: 700; text-transform: uppercase; }
  .experience-description { max-width: 52rem; margin-top: 1.5rem; color: var(--page-muted); font-size: 0.95rem; }
  .experience-highlights { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: 1.5rem; margin-top: 2rem; }
  .experience-highlights h3 { color: var(--page-accent); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .experience-highlights ul { color: var(--page-muted); font-size: 0.86rem; }
  .experience-highlights li { position: relative; padding-left: 1rem; }
  .experience-highlights li + li { margin-top: 0.65rem; }
  .experience-highlights li::before { position: absolute; left: 0; color: var(--page-accent); content: '—'; }
  .experience-skills { display: flex; flex-wrap: wrap; gap: 0.55rem 1.2rem; margin-top: 2rem; color: var(--page-muted); font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .experience-skills li { display: flex; align-items: center; gap: 0.5rem; }
  .experience-skills li::before { width: 0.25rem; height: 0.25rem; border-radius: 999px; background: var(--page-accent); content: ''; }
  .experience-editorial a:focus-visible { border-radius: 0.2rem; box-shadow: 0 0 0 3px hsl(var(--background)), 0 0 0 5px var(--page-accent) !important; }

  @media (max-width: 760px) {
    .hero-grid { grid-template-columns: 1fr; }
    .experience-entry { grid-template-columns: 1fr; }
    .experience-heading { flex-direction: column; }
    .period-line { text-align: left; }
    .experience-highlights { grid-template-columns: 1fr; gap: 0.75rem; }
  }
</style>
